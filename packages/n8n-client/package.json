{
  "name": "@egose/n8n-client",
  "description": "TypeScript client for the n8n Public API with cursor-based pagination and typed resource handles.",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "sideEffects": false,
  "repository": "PLACEHOLDER",
  "keywords": [
    "n8n",
    "n8n-api",
    "workflow-automation",
    "automation",
    "typescript",
    "client",
    "api-client"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json && pnpm build && pnpm typecheck:consumers && pnpm docs:check",
    "typecheck:consumers": "tsc --noEmit -p tests/fixtures/consumer-esm/tsconfig.json && tsc --noEmit -p tests/fixtures/consumer-cjs/tsconfig.json",
    "docs:check": "node scripts/check-readme-examples.mjs",
    "pack:verify": "node scripts/verify-package.mjs",
    "test": "pnpm test:unit && pnpm docs:check",
    "test:docs": "pnpm build && pnpm docs:check",
    "test:unit": "pnpm --filter @egose/n8n-client... build && vitest run --no-cache --config vitest.unit.config.ts",
    "test:integration": "pnpm --filter @egose/n8n-client... build && vitest run --no-cache --config vitest.integration.config.ts"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/egose/n8n-client/issues"
  },
  "homepage": "https://n8n-client.pages.dev/",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "publint": "^0.3.15",
    "yaml": "^2.9.0"
  }
}
